{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo build",
            "type": "shell",
            "command": "cargo build",
            "group": "build",
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Prepare Rust",
            "type": "shell",
            "command": "make rustavailable && make LLVM=1 rust-analyzer",
            "options": {
                "cwd": "${workspaceFolder}/linux/"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Prepare C/C++",
            "type": "shell",
            "command": "make compile_commands.json",
            "options": {
                "cwd": "${workspaceFolder}/linux/"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Configure kernel",
            "type": "shell",
            "command": "make menuconfig",
            "options": {
                "cwd": "${workspaceFolder}/linux/"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Default configure kernel",
            "type": "shell",
            "command": "make defconfig",
            "options": {
                "cwd": "${workspaceFolder}/linux/"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Build kernel without debug symbols",
            "type": "shell",
            "command": "make LLVM=1 -j$(nproc)",
            "options": {
                "cwd": "${workspaceFolder}/linux/"
            },
            "problemMatcher": [
                {
                    "owner": "gcc",
                    "fileLocation": ["relative", "${workspaceFolder}/linux"],
                    "pattern": [
                        {
                            "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                            "file": 1,
                            "line": 2,
                            "column": 3,
                            "severity": 4,
                            "message": 5
                        }
                    ]
                }
            ],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build kernel with debug symbols",
            "type": "shell",
            "command": "make LLVM=1 CONFIG_DEBUG_INFO=y CONFIG_DEBUG_INFO_REDUCED=n CONFIG_DEBUG_INFO_SPLIT=y CONFIG_DEBUG_INFO_DWARF5=y -j$(nproc)",
            "options": {
                "cwd": "${workspaceFolder}/linux/"
            },
            "problemMatcher": [
                {
                    "owner": "gcc",
                    "fileLocation": ["relative", "${workspaceFolder}/linux"],
                    "pattern": [
                        {
                            "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                            "file": 1,
                            "line": 2,
                            "column": 3,
                            "severity": 4,
                            "message": 5
                        }
                    ]
                }
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Run kernel",
            "type": "shell",
            "command": "virtme-ng -r arch/x86/boot/bzImage --memory=1G --disable-microvm --verbose",
            "options": {
                "cwd": "${workspaceFolder}/linux/"
            },
            "dependsOrder": "sequence",
            "dependsOn": ["Build kernel without debug symbols"],
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Run kernel in debug mode",
            "type": "shell",
            "command": "virtme-ng -r arch/x86/boot/bzImage --memory=1G --disable-microvm --verbose --debug",
            "options": {
                "cwd": "${workspaceFolder}/linux/"
            },
            "dependsOrder": "sequence",
            "dependsOn": ["Build kernel with debug symbols"],
            "problemMatcher": [],
            "isBackground": true,
            "group": "test"
        }
    ]
}