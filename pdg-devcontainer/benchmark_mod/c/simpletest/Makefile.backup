obj-m += simple_driver.o

# Use the correct kernel directory
KERNEL_DIR ?= /workspaces/UROP-Rust4Linux/linux-kernel-devcontainer/linux-rust

# Set up WLLVM environment
export LLVM_COMPILER := clang
export CC := wllvm
export HOSTCC := wllvm

all:
	@echo "Using kernel directory: $(KERNEL_DIR)"
	@if [ ! -d "$(KERNEL_DIR)" ]; then echo "ERROR: Kernel directory $(KERNEL_DIR) does not exist!"; exit 1; fi
	make LLVM=1 CC=$(CC) HOSTCC=$(HOSTCC) -C $(KERNEL_DIR) M=$(PWD) modules

clean:
	make LLVM=1 -C $(KERNEL_DIR) M=$(PWD) clean

install:
	sudo insmod simple_driver.ko

uninstall:
	sudo rmmod simple_driver

test:
	@echo "Testing C simple driver..."
	@echo "test data" | sudo tee /dev/simple_bench_c
	@sudo cat /dev/simple_bench_c
	@cat /proc/simple_bench_c_stats

# Extract bitcode after successful build
extract-bc: simple_driver.ko
	extract-bc simple_driver.ko
	@echo "Bitcode extracted to simple_driver.ko.bc"