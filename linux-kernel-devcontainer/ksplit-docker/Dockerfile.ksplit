FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# Install basics and LLVM 10 toolchain
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential cmake git wget curl \
      llvm-10 llvm-10-dev clang-10 \
      python3 python3-pip python3-venv \
      pkg-config ca-certificates && \
    update-alternatives --install /usr/bin/clang clang /usr/bin/clang-10 100 && \
    update-alternatives --install /usr/bin/llvm-config llvm-config /usr/bin/llvm-config-10 100 && \
    rm -rf /var/lib/apt/lists/*

# Install WLLVM (for extracting .bc)
RUN pip3 install --no-cache-dir wllvm

# Clone and build PDG (the KSplit analysis engine)
WORKDIR /opt
RUN git clone https://github.com/ksplit/pdg.git && \
    cd pdg && \
    git submodule update --init --recursive && \
    mkdir build && cd build && \
    cmake .. -DLLVM_DIR=/usr/lib/llvm-10/cmake && \
    make -j$(nproc)

# Make /workspace available for your code
WORKDIR /workspace
CMD ["/bin/bash"]
